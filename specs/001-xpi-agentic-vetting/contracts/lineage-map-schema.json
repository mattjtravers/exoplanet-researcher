{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xpi.science/lineage/v1/schema",
  "title": "XPI Lineage Map",
  "description": "JSON-LD provenance document for one XPI Vetting Report",
  "type": "object",
  "required": ["@context", "target_id", "entries", "confidence_entries", "created_at", "schema_version"],
  "additionalProperties": false,
  "properties": {
    "@context": {
      "type": "string",
      "const": "https://xpi.science/lineage/v1"
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/LineageEntry"
      }
    },
    "confidence_entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ConfidenceLineageEntry"
      }
    }
  },
  "$defs": {
    "LineageEntry": {
      "type": "object",
      "required": ["parameter_name", "parameter_value", "tool_call_id", "source_id", "source_type", "agent", "timestamp"],
      "additionalProperties": false,
      "properties": {
        "parameter_name": { "type": "string", "minLength": 1 },
        "parameter_value": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
        "tool_call_id": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "source_type": {
          "type": "string",
          "enum": ["nasa_quarter", "arxiv", "ads", "candidate"]
        },
        "agent": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "ConfidenceLineageEntry": {
      "type": "object",
      "required": ["agent", "score", "disposition", "primary_evidence", "timestamp"],
      "additionalProperties": false,
      "properties": {
        "agent": { "type": "string", "enum": ["observer", "scholar"] },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "disposition": {
          "type": "string",
          "enum": ["planet_candidate", "false_positive", "inconclusive"]
        },
        "primary_evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  }
}
